# Copy to .env and fill in for your environment.

DATABASE_URL="file:./dev.db"

# Admin panel (§6.1) — single shared password to start.
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# Feature flags
NEXT_PUBLIC_LIFF_ENABLED="false"

# Payment integrations. "stub" = fake-success flow, no external calls/keys needed.
# Switch to real providers only once real credentials are available (see Milestone 9).
PAYMENT_PROVIDER="stub"
SLIP_VERIFIER="stub"
PROMPTPAY_ID=""
SLIPOK_API_KEY=""
