// Prisma schema for Sevendays Badminton booking system.
// SQLite in dev; swap the datasource url to Postgres for production.
// SQLite has no native enum/scalar-list support, so status/court/court_numbers
// are typed as String/Json here and constrained at the app layer (see lib/types.ts).

datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

model Customer {
  id         String   @id @default(cuid())
  lineUserId String?  @unique @map("line_user_id")
  name       String
  phone      String
  email      String?
  createdAt  DateTime @default(now()) @map("created_at")

  // Membership (§ package system) — presence of `username` means this
  // customer is also a member. Password is chosen by the customer; admin
  // just keys it in. Hashed with scrypt + a per-user salt, never stored
  // or logged in plain text (see lib/members/auth.ts).
  username     String? @unique
  passwordHash String? @map("password_hash")
  passwordSalt String? @map("password_salt")

  bookings       Booking[]
  memberPackages MemberPackage[]

  @@map("customers")
}

/**
 * Admin-defined package plan (e.g. "10 Hours") — creatable/editable in
 * the admin panel, not hardcoded, since rates/offerings change.
 */
model PackageType {
  id           String   @id @default(cuid())
  name         String
  hours        Int
  validityDays Int      @map("validity_days")
  price        Int? // THB, record-keeping only — packages are paid for off-platform
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  memberPackages MemberPackage[]

  @@map("package_types")
}

/**
 * One purchased/assigned package instance for a member. Admin creates
 * these after the customer pays off-platform (LINE or in person).
 */
model MemberPackage {
  id            String      @id @default(cuid())
  customer      Customer    @relation(fields: [customerId], references: [id])
  customerId    String      @map("customer_id")
  packageType   PackageType @relation(fields: [packageTypeId], references: [id])
  packageTypeId String      @map("package_type_id")

  purchasedAt    DateTime @default(now()) @map("purchased_at")
  expiresAt      DateTime @map("expires_at") // purchasedAt + packageType.validityDays, computed at creation
  hoursRemaining Int      @map("hours_remaining")

  // Soft "unassign" (§ admin ask): record stays for audit — existing
  // bookings' memberPackageId references stay valid — but hours are
  // zeroed and it can no longer be looked up or spent from (see
  // lib/members/queries.ts, lib/members/checkout.ts).
  revoked   Boolean   @default(false)
  revokedAt DateTime? @map("revoked_at")

  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")

  bookings Booking[]

  @@index([customerId])
  @@map("member_packages")
}

model Booking {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String   @map("customer_id")

  date            String // YYYY-MM-DD
  startHour       Int    @map("start_hour") // 9-23, operating window 09:00-00:00
  durationMinutes Int    @map("duration_minutes") // 60 | 120 | 180 | 240
  court           String // 'pool' | 'court6'
  courtCount      Int    @default(1) @map("court_count") // meaningful only when court = 'pool'
  courtNumbers    Json   @default("[]") @map("court_numbers") // assigned by allocation engine; always [6] for court6

  status        String  @default("held") // held | paid | confirmed | released | cancelled
  locked        Boolean @default(false)
  gapPolicyFlag Boolean @default(false) @map("gap_policy_flag") // set when §4.5.1 gap policy placed this booking non-ideally

  // Soft-delete / recovery (§ admin "Deleted zone"): cancelledAt is set on
  // cancel, cleared on restore. needsAttention is set only when a restore
  // couldn't find a slot at all (distinct from gapPolicyFlag, which means
  // "fewer contiguous courts than requested," not "none").
  cancelledAt    DateTime? @map("cancelled_at")
  needsAttention Boolean   @default(false) @map("needs_attention")

  holdExpiresAt DateTime? @map("hold_expires_at")
  amountDue     Int       @map("amount_due") // THB, integer to avoid float rounding

  slipImageUrl           String? @map("slip_image_url")
  slipVerificationResult String? @map("slip_verification_result")

  // Manual payment review (§ admin "Check payment"): only ever set for
  // slip/bank-transfer payments — package and cash payments have nothing
  // to check against a slip, so this stays null for them.
  paymentCheckStatus String? @map("payment_check_status") // null | 'pending' | 'checked'

  paymentMethod   String?        @map("payment_method") // 'promptpay' | 'package' | 'cash'
  memberPackage   MemberPackage? @relation(fields: [memberPackageId], references: [id])
  memberPackageId String?        @map("member_package_id") // which package this booking drew hours from, if paid that way

  // Court reassignment (§ admin "Reassign"): captured once, on the first
  // reassignment only — never overwritten by later ones — so "Revert to
  // original" always means the true original slot, not just the last one.
  originalDate            String? @map("original_date")
  originalStartHour       Int?    @map("original_start_hour")
  originalDurationMinutes Int?    @map("original_duration_minutes")
  originalCourtNumbers    Json?   @map("original_court_numbers")

  updatedBy String?  @map("updated_by") // admin identifier for manual actions
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date, court])
  @@index([customerId])
  @@map("bookings")
}

/**
 * A single settings row for the customer-facing payment QR (§ payment page
 * redesign — replaces the PromptPay placeholder with a plain image the
 * admin uploads and can swap at any time). Always read/written at the
 * fixed id "singleton" — see lib/admin/payment-settings.ts.
 */
model PaymentSettings {
  id         String   @id @default("singleton")
  qrImageUrl String?  @map("qr_image_url")
  updatedBy  String?  @map("updated_by")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("payment_settings")
}
